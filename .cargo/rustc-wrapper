#!/bin/sh
# rustc-wrapper RUSTC ARGUMENT...
#
# Cargo's wrapper of rustc in this repository, which .cargo/config.toml names: trucker where it is installed, so that
# a new worktree takes its compiled crates from the machine's store, and rustc alone where it is not.
if command -v trucker > /dev/null 2>&1; then
    exec trucker "$@"
fi
exec "$@"
