def commands(bench, ripcloc, tools):
    """The (tool, argv) pairs that `bench` times, in a fixed order."""
    pairs = []
    for tool in tools:
        if tool == "ripcloc":
            flags = ["--no-attribution", "--large"] if bench.equal else []
            pairs.append(("ripcloc", [ripcloc, *flags, bench.path]))
        elif tool == "ripcloc -c":
            # `-c` is the same work as ripcloc's equal-work command, so it is left out of those benchmarks.
            if not bench.equal:
                pairs.append(("ripcloc -c", [ripcloc, "-c", bench.path]))
        elif tool == "scc":
            pairs.append(("scc", ["scc", *(["--no-complexity"] if bench.equal else []), bench.path]))
        else:
            pairs.append((tool, [tool, bench.path]))
    return pairs


def totals(tool, text):
    """The files and code lines in the total row of a tool's default text output, or `None` if it has none."""
    if tool == "cloc":
        # cloc prints no SUM row for a single language, so its one row of counts is the total.
        rows = [l.split() for l in text.splitlines() if re.match(r"^\S.*\s\d+\s+\d+\s+\d+\s+\d+$", l)]
        rows = [r for r in rows if r[0] != "github.com/AlDanial/cloc"]
        if not rows:
            return None
        total = next((r for r in rows if r[0] == "SUM:"), rows[-1])
        return int(total[-4]), int(total[-1])
    label, files, code = {"tokei": ("Total", 0, 2)}.get(tool, ("Total", 0, 4))
    found = None
    for line in text.splitlines():
        words = line.split()
        if words and words[0] == label:
            found = [int(w.replace(",", "")) for w in words[1:] if re.fullmatch(r"[\d,]+", w)]
    return (found[files], found[code]) if found else None


def run_once(argv, stdout):
    """Run `argv`, and return its wall time in seconds."""
    start = time.perf_counter()
    pid = os.posix_spawnp(argv[0], argv, os.environ, file_actions=[
        (os.POSIX_SPAWN_DUP2, stdout, 1),
        (os.POSIX_SPAWN_OPEN, 2, os.devnull, os.O_WRONLY, 0),
    ])
    _, status = os.waitpid(pid, 0)
    elapsed = time.perf_counter() - start
    if os.waitstatus_to_exitcode(status) != 0:
        sys.exit(f"{argv} failed with status {status}")
    return elapsed


def peak_memory(argv):
    """Run `argv` through `/usr/bin/time`, and return its peak resident memory in bytes and its output."""
    # GNU time reports the peak in KiB, and BSD time on macOS reports it in bytes.
    flags, scale = (["-l"], 1) if sys.platform == "darwin" else (["-f", "%M"], 1024)
    run = subprocess.run(["/usr/bin/time", *flags, *argv], capture_output=True)
    if run.returncode != 0:
        sys.exit(f"{argv} failed with status {run.returncode}")
    report = run.stderr.decode(errors="replace").splitlines()
    if sys.platform == "darwin":
        peak = next(int(l.split()[0]) for l in report if "maximum resident set size" in l)
    else:
        peak = int(report[-1])
    return peak * scale, run.stdout.decode(errors="replace")


def measure(bench, pairs, warmup, rounds, cloc_rounds, memory_runs):
    """The recorded runs of `bench`, as rows of the raw CSV."""
    rows = []
    counts = {}

    def record(tool, argv, kind, round_index, value):
        files, code = counts[tool] or ("", "")
        rows.append({
            "benchmark": bench.name, "tool": tool, "command": " ".join(argv[1:]), "kind": kind,
            "round": round_index, "value": value, "files": files, "code": code,
        })

    for round_index in range(memory_runs):
        for tool, argv in pairs:
            if tool != "cloc":
                peak, output = peak_memory(argv)
                if round_index == 0:
                    counts[tool] = totals(tool, output)
                record(tool, argv, "memory", round_index, peak)
    devnull = os.open(os.devnull, os.O_WRONLY)
    # cloc is so slow that each of its runs is timed and measured at once, through `/usr/bin/time`, whose own cost is
    # small beside cloc's. Its runs come after the rounds of the other tools, since a run of cloc between theirs slowed
    # the next runs of every other tool.
    rotated = [(tool, argv) for tool, argv in pairs if tool != "cloc"]
    for round_index in range(warmup + rounds):
        shift = round_index % len(rotated)
        for tool, argv in rotated[shift:] + rotated[:shift]:
            elapsed = run_once(argv, devnull)
            if round_index >= warmup:
                record(tool, argv, "time", round_index - warmup, f"{elapsed:.6f}")
    for tool, argv in pairs:
        if tool == "cloc":
            for round_index in range(cloc_rounds):
                start = time.perf_counter()
                peak, output = peak_memory(argv)
                elapsed = time.perf_counter() - start
                if round_index == 0:
                    counts[tool] = totals(tool, output)
                record(tool, argv, "memory", round_index, peak)
                record(tool, argv, "time", round_index, f"{elapsed:.6f}")
    os.close(devnull)
    return rows


def environment(corpora, ripcloc, tools, cpus):
    def version(argv):
        try:
            out = subprocess.run(argv, capture_output=True, text=True).stdout
        except FileNotFoundError:
            return "missing"
        return next((l.strip() for l in out.splitlines() if l.strip()), "unknown")

    lines = [f"date: {datetime.now(timezone.utc):%Y-%m-%dT%H:%M:%SZ}", f"kernel: {platform.system()} {platform.release()}"]
    if Path("/proc/cpuinfo").exists():
        model = next(l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name"))
        memory = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") // 2**30
        lines += [f"cpu: {model}, cpus {cpus} of {os.cpu_count()}", f"memory: {memory}G"]
    else:
        model = version(["sysctl", "-n", "machdep.cpu.brand_string"])
        lines += [f"cpu: {model}, {os.cpu_count()} cpus"]
    lines.append(f"ripcloc: {version([ripcloc, '--version'])}")
    for tool in dict.fromkeys(t for t in tools if not t.startswith("ripcloc")):
        lines.append(f"{tool}: {version([tool, '--version'])}")
    for name in sorted(CLONES):
        repo = corpora / name
        if (repo / ".git").exists():
            head = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"], capture_output=True, text=True).stdout
            lines.append(f"corpus {name}: {head.strip()}")
    return lines


def seconds(s):
    return f"{s * 1000:.1f}ms" if s < 1 else f"{s:.3f}s"


def mebibytes(b):
    return f"{b / 2**20:.1f} MiB"


def summarize(rows):
    """Each tool's runs of one benchmark, as (tool, mean, stdev, peak memory, files, code), fastest first."""
    by_tool = {}
    for row in rows:
        by_tool.setdefault(row["tool"], []).append(row)
    results = []
    for tool, runs in by_tool.items():
        times = [float(r["value"]) for r in runs if r["kind"] == "time"]
        # A single run has no deviation to report.
        stdev = statistics.stdev(times) if len(times) > 1 else None
        rss = statistics.median(int(r["value"]) for r in runs if r["kind"] == "memory")
        results.append((tool, statistics.mean(times), stdev, rss, runs[0]["files"], runs[0]["code"]))
    return sorted(results, key=lambda r: r[1])


def number(n):
    return f"{int(n):,}" if str(n).isdigit() else "?"


def print_summary(bench, rows):
    heading = f"{bench.name} ({bench.path})"
    print(f"{heading}\n{'-' * len(heading)}")
    results = summarize(rows)
    width = max(len(r[0]) for r in results) + 1
    for i, (tool, mean, stdev, rss, files, code) in enumerate(results):
        star = "*" if i == 0 else " "
        spread = f"+/- {stdev:.4f}" if stdev is not None else " " * 10
        print(f"{tool + star:<{width}} {mean:8.4f} {spread}  {mebibytes(rss):>11}  "
              f"(files: {number(files)}, code: {number(code)})")
    print(flush=True)


def print_markdown(raw):
    rows = list(csv.DictReader(open(raw)))
    names = list(dict.fromkeys(r["benchmark"] for r in rows))
    by_name = {b.name: b for b in BENCHMARKS}
    for name in names:
        bench = by_name.get(name, Benchmark(name, name, name))
        results = summarize([r for r in rows if r["benchmark"] == name])
        fastest = results[0][1]
        print(f"#### {bench.title}\n")
        print("| Tool | Files | Code lines | Time | Memory |")
        print("| ---- | ----: | ---------: | ---: | -----: |")
        for i, (tool, mean, stdev, rss, files, code) in enumerate(results):
            time_ = seconds(mean) if stdev is None else f"{seconds(mean)} ± {seconds(stdev)}"
            if i == 0:
                time_ = f"**{time_}**"
            print(f"| {LINKS.get(tool, tool)} | {number(files)} | {number(code)} | {time_} ({mean / fastest:.2f}x) "
                  f"| {mebibytes(rss)} |")
        print()
    print_geometric_means(rows, names, by_name)


def print_geometric_means(rows, names, by_name):
    """Print each tool's time and memory as multiples of ripcloc's, combined over the benchmarks by their geometric
    mean, with the range of the multiples beside it."""
    for equal, title in [(False, "default settings"), (True, "equal work")]:
        ratios = {}
        for name in names:
            if by_name.get(name, Benchmark(name, name, name)).equal != equal:
                continue
            results = {r[0]: r for r in summarize([r for r in rows if r["benchmark"] == name])}
            base = results.get("ripcloc")
            if not base:
                continue
            for tool, (_, mean, _, rss, _, _) in results.items():
                if tool != "ripcloc":
                    ratios.setdefault(tool, []).append((mean / base[1], rss / base[3]))
        if not ratios:
            continue
        print(f"#### Multiples of ripcloc, {title}\n")
        print("| Tool | Benchmarks | Time | Time range | Memory | Memory range |")
        print("| ---- | ---------: | ---: | ---------: | -----: | -----------: |")
        for tool, pairs in ratios.items():
            times, memories = zip(*pairs)
            print(f"| {LINKS.get(tool, tool)} | {len(pairs)} | {statistics.geometric_mean(times):.2f}x "
                  f"| {min(times):.2f}x–{max(times):.2f}x | {statistics.geometric_mean(memories):.2f}x "
                  f"| {min(memories):.2f}x–{max(memories):.2f}x |")
        print()


def download(corpora):
    corpora.mkdir(parents=True, exist_ok=True)

    def clone(item):
        name, (url, commit) = item
        repo = corpora / name
        if repo.exists():
            return
        repo.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "init", "-q", repo], check=True)
        subprocess.run(["git", "-C", repo, "fetch", "-q", "--depth", "1", url, commit], check=True)
        subprocess.run(["git", "-C", repo, "checkout", "-q", "FETCH_HEAD"], check=True)
        print(f"cloned {name}", file=sys.stderr)

    with ThreadPoolExecutor(8) as pool:
        list(pool.map(clone, CLONES.items()))

    def fetch(url):
        with urllib.request.urlopen(url) as response:
            return response.read()

    if not (corpora / "grep-3.12").exists():
        tarfile.open(fileobj=io.BytesIO(fetch("https://ftp.gnu.org/gnu/grep/grep-3.12.tar.xz"))).extractall(
            corpora, filter="data")
    if not (corpora / "sqlite-amalgamation-3500400").exists():
        zipfile.ZipFile(io.BytesIO(fetch("https://www.sqlite.org/2025/sqlite-amalgamation-3500400.zip"))).extractall(
            corpora)
    checker = corpora / "typescript-5.6.3" / "checker.ts"
    if not checker.exists():
        checker.parent.mkdir(exist_ok=True)
        checker.write_bytes(
            fetch("https://raw.githubusercontent.com/microsoft/TypeScript/v5.6.3/src/compiler/checker.ts"))

    for name, (source, patterns) in COPIES.items():
        to = corpora / name
        if to.exists():
            continue
        for directory, subdirectories, files in os.walk(corpora / source):
            subdirectories[:] = [d for d in subdirectories if d != ".git"]
            for file in files:
                if any(fnmatch.fnmatchcase(file, p) for p in patterns):
                    path = Path(directory, file)
                    target = to / path.relative_to(corpora / source)
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, target, follow_symlinks=False)
        print(f"copied {name}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("benchmarks", nargs="*", help="the benchmarks to run, by default every one")
    parser.add_argument("--dir", type=Path, help="the directory of corpora")
    parser.add_argument("--download", action="store_true", help="download the corpora into --dir and exit")
    parser.add_argument("--raw", type=Path, help="write every recorded run to this CSV file")
    parser.add_argument("--markdown", type=Path, metavar="RAW", help="print a raw CSV file as Markdown tables and exit")
    parser.add_argument("--list", action="store_true", help="list the benchmarks and exit")
    parser.add_argument("--ripcloc", default=str(ROOT / "target" / "release" / "ripcloc"))
    parser.add_argument("--tools", default="ripcloc,ripcloc -c,tokei,scc,cloc", help="comma-separated, in order")
    parser.add_argument("--cpus", default="1-15", help="the cores to pin to on Linux")
    parser.add_argument("--warmup", type=int, default=3)
    parser.add_argument("--rounds", type=int, default=10)
    parser.add_argument("--cloc-rounds", type=int, default=1)
    parser.add_argument("--memory-runs", type=int, default=3)
    args = parser.parse_args()

    if args.list:
        for b in BENCHMARKS:
            print(f"{b.name:14} {b.path}")
        return
    if args.markdown:
        print_markdown(args.markdown)
        return
    if not args.dir:
        parser.error("--dir is required")
    corpora = args.dir.resolve()
    if args.download:
        download(corpora)
        return

    unknown = set(args.benchmarks) - {b.name for b in BENCHMARKS}
    if unknown:
        parser.error(f"unknown benchmarks: {', '.join(sorted(unknown))}")
    selected = [b for b in BENCHMARKS if not args.benchmarks or b.name in args.benchmarks]
    tools = [t.strip() for t in args.tools.split(",") if t.strip()]
    ripcloc = str(Path(args.ripcloc).resolve())
    if hasattr(os, "sched_setaffinity"):
        cores = set()
        for part in args.cpus.split(","):
            low, _, high = part.partition("-")
            cores.update(range(int(low), int(high or low) + 1))
        os.sched_setaffinity(0, cores)

    for line in environment(corpora, ripcloc, tools, args.cpus):
        print(line)
    print(flush=True)
    # The raw file is opened before the move into the corpora, so that a relative path is from where the suite ran.
    raw = open(args.raw, "w", newline="") if args.raw else None
    os.chdir(corpora)
    writer = None
    for bench in selected:
        print(f"running {bench.name}", file=sys.stderr)
        rows = measure(
            bench, commands(bench, ripcloc, tools), args.warmup, args.rounds, args.cloc_rounds, args.memory_runs
        )
        if raw:
            writer = writer or csv.DictWriter(raw, fieldnames=list(rows[0]))
            if raw.tell() == 0:
                writer.writeheader()
            writer.writerows(rows)
            raw.flush()
        print_summary(bench, rows)


if __name__ == "__main__":
    main()
