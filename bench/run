#!/usr/bin/env bash
# Benchmarks ripcloc against other line counters with hyperfine, in the manner of ripgrep's benchsuite.
#
#   bench/run <corpora> <out> [benchmark]...
#
# <corpora> holds the checkouts that bench/fetch makes. Every benchmark runs with a warm page cache, with each tool's
# default settings, since that is what a user sees. Each tool's file and code totals are recorded beside its time,
# because the tools disagree on what a file of code is and a fast tool that skips work is not fast.
set -euo pipefail

corpora=$(realpath "$1")
mkdir -p "$2"
out=$(realpath "$2")
shift 2

here=$(realpath "$(dirname "$0")")
ripcloc=${RIPCLOC:-$here/../target/release/ripcloc}
ripcloc=$(realpath "$ripcloc")
# On Linux every command is pinned to CPUS, so that a box shared by a reservation is measured the same way each time.
# macOS has no pinning, so there every core is used.
cpus=${CPUS:-1-15}
pin=()
if command -v taskset >/dev/null; then pin=(taskset -c "$cpus"); fi

declare -A target=(
  [large_c]=sqlite-amalgamation-3500400/sqlite3.c
  [large_rust]=rust/library/stdarch/crates/core_arch/src/x86/avx512f.rs
  [large_ts]=typescript-5.6.3/checker.ts
  [small_file]=ripgrep/crates/core/main.rs
  [ripcloc]=ripcloc
  [cloc]=cloc
  [grep]=grep-3.12
  [ripgrep]=ripgrep
  [react]=react
  [rails]=rails
  [rust]=rust
  [linux]=linux
  [linux_ch]=linux-ch
  [rust_rs]=rust-rs
  [react_js]=react-js
)
order=(large_c large_rust large_ts small_file ripcloc cloc grep ripgrep react rails rust linux linux_ch rust_rs react_js)
[ $# -gt 0 ] && order=("$@")

# TOOLS picks the tools and the order they run in. ripcloc-noattr is ripcloc without attributing lines to source and
# tests, the work that tokei and scc do not do. SAME_WORK=1 turns off the work that only one tool does by default:
# scc's complexity, and ripcloc's attribution and cap on file size.
read -ra tools <<< "${TOOLS:-ripcloc tokei scc cloc}"
command_for() {
  case $1:${SAME_WORK:-} in
    ripcloc:1) echo "$ripcloc --no-attribution --large $2" ;;
    ripcloc:*) echo "$ripcloc $2" ;;
    ripcloc-noattr:1) echo "$ripcloc --no-attribution --large $2" ;;
    ripcloc-noattr:*) echo "$ripcloc --no-attribution $2" ;;
    scc:1) echo "scc --no-complexity $2" ;;
    *) echo "$1 $2" ;;
  esac
}

{
  echo "date: $(date -u +%FT%TZ)"
  echo "kernel: $(uname -sr)"
  if [ -r /proc/cpuinfo ]; then
    echo "cpu: $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | xargs), cpus $cpus of $(nproc)"
    echo "memory: $(free -g | awk '/Mem:/ {print $2}')G"
  else
    echo "cpu: $(sysctl -n machdep.cpu.brand_string), $(sysctl -n hw.ncpu) cpus"
    echo "memory: $(( $(sysctl -n hw.memsize) / 1073741824 ))G"
  fi
  echo "hyperfine: $(hyperfine --version)"
  echo "ripcloc: $($ripcloc --version)"
  for tool in "${tools[@]}"; do
    case $tool in
      ripcloc | ripcloc-noattr) ;;
      gocloc) echo "gocloc: $(go version -m "$(command -v gocloc)" | awk '$1 == "mod" {print $3}')" ;;
      *) echo "$tool: $($tool --version | head -1)" ;;
    esac
  done
  for d in "${target[@]}"; do
    d=${d%%/*}
    if [ -d "$corpora/$d/.git" ]; then echo "corpus $d: $(git -C "$corpora/$d" rev-parse HEAD)"; fi
  done | sort -u
} > "$out/environment.txt"

cd "$corpora"
for bench in "${order[@]}"; do
  path=${target[$bench]}
  echo "== $bench ($path)" >&2
  args=()
  : > "$out/$bench.counts"
  for tool in "${tools[@]}"; do
    cmd=$(command_for "$tool" "$path")
    # cloc prints no total row for a single language, so its totals come from its JSON.
    counts=$cmd
    [ "$tool" = cloc ] && counts="cloc --json --quiet $path"
    $counts 2>/dev/null | python3 -I "$here/totals.py" "$tool" >> "$out/$bench.counts"
    args+=(-n "$tool" "$cmd")
  done
  # hyperfine is pinned rather than each command, so that no extra exec is timed.
  "${pin[@]}" hyperfine -N --style basic --warmup 3 --min-runs 10 --export-json "$out/$bench.json" "${args[@]}"
done
