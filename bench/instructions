#!/usr/bin/env python3
"""Counts the instructions that line counting takes, which show changes that are too small for wall time
on a shared or loaded machine.

    bench/instructions                        # the instructions of each input
    bench/instructions --save base.txt        # the same, saved as a baseline
    bench/instructions --baseline base.txt    # the change from a baseline, flagged when over 1%

The inputs are generated by crates/cli/benches/count.rs, which is built with `cargo bench --no-run` and run
once for each input, and once without counting, whose instructions are taken off the others. The
instructions of a run are read from outside the process: on macOS from the "instructions retired" line of
`/usr/bin/time -l`, and on Linux from `perf stat -x, -e instructions:u`. Each input is run several times,
and its least count is kept, since noise only adds instructions.

Counts depend on the machine, the operating system and the toolchain, so a baseline compares only with
counts made on the same machine with the same toolchain. To compare two commits, save a baseline in a
checkout of the first and compare against it in a checkout of the second. A commit from before the
benchmark existed needs crates/cli/benches/count.rs and its `[[bench]]` entry in crates/cli/Cargo.toml
copied in.

The script exits with 1 when a change from the baseline is over the limit.
"""

import argparse
import json
import platform
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
INPUTS = ["c", "js", "rs"]


def build():
    """The path of the benchmark executable, built in release mode."""
    command = ["cargo", "bench", "--bench", "count", "--no-run", "--message-format=json"]
    result = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, text=True, check=True)
    for line in result.stdout.splitlines():
        message = json.loads(line)
        target = message.get("target", {})
        if message.get("reason") == "compiler-artifact" and target.get("kind") == ["bench"]:
            return message["executable"]
    sys.exit("instructions: cargo built no benchmark executable")


def parse_time(stderr):
    """The instructions retired that `/usr/bin/time -l` reports in `stderr`, or None."""
    match = re.search(r"^\s*(\d+)\s+instructions retired\s*$", stderr, re.MULTILINE)
    return int(match.group(1)) if match else None


def parse_perf(stderr):
    """The user-space instructions that `perf stat -x,` reports in `stderr`, or None.

    A machine with two kinds of core, such as a hybrid Intel one, reports a line for each kind, as in
    `cpu_core/instructions/u`, and the run's instructions are their sum.
    """
    counts = []
    for line in stderr.splitlines():
        fields = line.split(",")
        if len(fields) > 2 and "instructions" in fields[2] and fields[0].isdigit():
            counts.append(int(fields[0]))
    return sum(counts) if counts else None


PERF_HELP = """\
instructions: perf could not count the instructions of the benchmark.

{stderr}
Counting needs `perf`, from the linux-tools package of the running kernel, and a
kernel.perf_event_paranoid of at most 2, which lets a user count the instructions of their own
processes. Allow it until the next boot with

    sudo sysctl kernel.perf_event_paranoid=2

or for good with a line `kernel.perf_event_paranoid = 2` in a file in /etc/sysctl.d/."""


def instructions(executable, argument):
    """The instructions of a run of `executable` with `argument`."""
    system = platform.system()
    if system == "Darwin":
        command = ["/usr/bin/time", "-l", executable, argument]
        parse = parse_time
    elif system == "Linux":
        if shutil.which("perf") is None:
            sys.exit(PERF_HELP.format(stderr="perf is not installed."))
        command = ["perf", "stat", "-x,", "-e", "instructions:u", "--", executable, argument]
        parse = parse_perf
    else:
        sys.exit(f"instructions: counting instructions on {system} is not supported")
    result = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    count = parse(result.stderr)
    if result.returncode != 0 or count is None:
        if system == "Linux":
            sys.exit(PERF_HELP.format(stderr=result.stderr.strip()))
        sys.exit(f"instructions: {' '.join(command)} failed:\n{result.stderr.strip()}")
    return count


def measure(executable, runs):
    """The least instructions of `runs` runs of each input, less those of generating the inputs."""
    least = {name: min(instructions(executable, name) for _ in range(runs)) for name in ["none", *INPUTS]}
    return {name: least[name] - least["none"] for name in INPUTS}


def read_baseline(path):
    baseline = {}
    for line in Path(path).read_text().splitlines():
        if line.strip():
            name, count = line.split()
            baseline[name] = int(count)
    return baseline


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--save", metavar="FILE", help="save the counts as a baseline in FILE")
    parser.add_argument("--baseline", metavar="FILE", help="compare the counts with the baseline in FILE")
    parser.add_argument("--limit", type=float, default=1.0, help="the percent change that is flagged [1]")
    parser.add_argument("--runs", type=int, default=3, help="the runs of each input [3]")
    args = parser.parse_args()

    counts = measure(build(), args.runs)
    baseline = read_baseline(args.baseline) if args.baseline else {}
    flagged = False
    print(f"{'input':8} {'instructions':>14}" + (f" {'baseline':>14} {'change':>8}" if baseline else ""))
    for name, count in counts.items():
        line = f"{name:8} {count:>14,}"
        if name in baseline:
            change = (count - baseline[name]) * 100 / baseline[name]
            line += f" {baseline[name]:>14,} {change:>+7.2f}%"
            if abs(change) > args.limit:
                line += "  changed"
                flagged = True
        print(line)
    if args.save:
        Path(args.save).write_text("".join(f"{name} {count}\n" for name, count in counts.items()))
    if flagged:
        print(f"An input changed by more than {args.limit}% from the baseline.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
